# ================================================================
# Email Automation & Reminder System - Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR CREDENTIALS
# DO NOT COMMIT YOUR REAL .env FILE TO GIT / GITHUB!
# ================================================================

# System Operation Mode
# Set DRY_RUN=True to simulate sending emails without hitting SMTP servers
# Set DRY_RUN=False to send real emails via your SMTP provider
DRY_RUN=True

# SMTP Provider Settings (Gmail default)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True

# Your Sender Credentials
# For Gmail, use your 16-character Google App Password (NOT your normal password)
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
SENDER_NAME=Automation Operations Team
SENDER_EMAIL=your_email@gmail.com

# Timezone (e.g., Asia/Kolkata, UTC, America/New_York)
TIMEZONE=Asia/Kolkata

# Database URL for advanced API mode
DATABASE_URL=sqlite:///data/email_automation.db

# API Host & Port
API_HOST=127.0.0.1
API_PORT=8000
